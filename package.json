{
  "name": "ultrapilot",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:live": "esbuild tests/live-relay.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/live-relay.test.cjs --log-level=warning && node node_modules/.cache/live-relay.test.cjs",
    "test:nav": "esbuild tests/nav.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/nav.test.cjs --log-level=warning && node node_modules/.cache/nav.test.cjs",
    "test": "npm run -s test:live && npm run -s test:nav && npm run -s test:awake && npm run -s test:viewport && npm run -s test:dirline && npm run -s test:traffic",
    "test:traffic": "esbuild tests/traffic.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/traffic.test.cjs --log-level=warning && node node_modules/.cache/traffic.test.cjs",
    "test:dirline": "esbuild tests/direction-line.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/direction-line.test.cjs --log-level=warning && node node_modules/.cache/direction-line.test.cjs",
    "test:awake": "esbuild tests/keep-awake.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/keep-awake.test.cjs --log-level=warning && node node_modules/.cache/keep-awake.test.cjs",
    "test:viewport": "esbuild tests/viewport.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/viewport.test.cjs --log-level=warning && node node_modules/.cache/viewport.test.cjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.7",
    "idb": "^8.0.0",
    "maplibre-gl": "^5.23.0",
    "pmtiles": "^4.4.1",
    "protomaps-themes-base": "^4.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.2.0"
  }
}
